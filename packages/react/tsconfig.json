{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "paths": {
      "v0/browser": ["../v0-sdk/src/browser.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}

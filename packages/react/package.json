{
  "name": "@v0-sdk/react",
  "version": "3.0.3",
  "description": "React hooks and AI SDK transport for the v0 API",
  "keywords": [
    "ai",
    "react",
    "sdk",
    "swr",
    "v0",
    "vercel"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/v0-sdk.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "swr": [
        "dist/swr.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./swr": {
      "import": "./dist/swr.mjs",
      "require": "./dist/swr.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "bun src/scripts/generate.ts",
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "bun test",
    "prepublishOnly": "bun run generate && bun run build"
  },
  "dependencies": {
    "v0": "3.0.3"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.34",
    "@arethetypeswrong/core": "^0.18.2",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "ai": "^7.0.31",
    "publint": "^0.3.18",
    "react": "19.2.5",
    "react-test-renderer": "19.2.5",
    "swr": "^2.3.6",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "swr": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
